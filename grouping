from schemas import PipelineConfig

def evaluate_allowed_stages(config: PipelineConfig, completed: Set[str]) -> List[str]:
    """Calculates allowed stages dynamically based on completed prerequisites."""
    allowed = []
    for stage in config.stages:
        if stage.stage_id in completed:
            continue
        if set(stage.depends_on).issubset(completed):
            allowed.append(stage.stage_id)
    return allowed

def execute_stage_handler(action_type: str, stage_id: str, item_id: str, payload: dict) -> Dict[str, Any]:
