## Step 3: Data_Server.py (the main change)

**Where:** find `def init_db():` around line 129. Delete that whole function and paste this block in its place:

```python
from sqlalchemy import event
from sqlalchemy.orm import Session, with_loader_criteria, object_session

# Tables that are NOT filtered by plant
EXCLUDE = {UserScope, Plant}

# Tables that already have a plant column with a different name
EXTRA = {PcbData: "plant", BOMItem: "plant",
         FlowManagement: "plant", PartProcessTime: "plant"}

_cache = None
def scoped_models():
    """Finds every table that has a plant_code column, automatically."""
    global _cache
    if _cache is None:
        found = {}
        for m in base.registry.mappers:
            cls = m.class_
            if cls in EXCLUDE:
                continue
            if cls in EXTRA:
                found[cls] = EXTRA[cls]
            elif hasattr(cls, "plant_code"):
                found[cls] = "plant_code"
        _cache = found
    return _cache

def get_scope(payload=Depends(verify_token)):
    """Which plants can this user see? None = no filtering."""
    if not isinstance(payload, dict):
        return None
    staff = payload.get("userID")          # <-- see "Confusions" below
    db = session()
    try:
        rows = db.query(UserScope.plant_code).filter(UserScope.userID == staff).all()
        return [r[0] for r in rows]
    finally:
        db.close()

def init_db(plants=Depends(get_scope)):
    db = session()
    db.info["plants"] = plants
    try:
        yield db
    finally:
        db.close()

# Adds "WHERE plant_code IN (...)" to every query automatically
@event.listens_for(Session, "do_orm_execute")
def add_plant_filter(state):
    plants = state.session.info.get("plants")
    if plants is None or not state.is_select:
        return
    state.statement = state.statement.options(*[
        with_loader_criteria(M, getattr(M, col).in_(plants), include_aliases=True)
        for M, col in scoped_models().items()
    ])

# When a user saves a NEW row, fill its plant_code automatically
@event.listens_for(base, "before_insert", propagate=True)
def stamp_plant(mapper, connection, target):
    col = scoped_models().get(type(target))
    if not col:
        return
    s = object_session(target)
    plants = s.info.get("plants") if s else None
    if plants and len(plants) == 1 and getattr(target, col) is None:
        setattr(target, col, plants[0])
```

Your endpoints stay exactly as they are. `db.query(Equipments).all()` now returns only the user's plant.

